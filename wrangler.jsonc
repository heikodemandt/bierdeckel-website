// Cloudflare-Konfiguration: liefert den fertig gebauten Ordner dist/ als statische Website aus.
// Build-Befehl im Cloudflare-Dashboard: npm run build
{
  "name": "bierdeckel-website",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Eigene Domain: Cloudflare legt DNS-Einträge und SSL-Zertifikate dafür automatisch an
  "routes": [
    { "pattern": "studiowanderer.com", "custom_domain": true },
    { "pattern": "www.studiowanderer.com", "custom_domain": true }
  ]
}
